# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. Never commit it, never paste its contents into a chat with an AI agent.

# ─────────────────────────────── RPC endpoint ───────────────────────────────
# Where transactions and reads go. Always takes priority.
#   Fork rehearsal:   http://127.0.0.1:8546        (a local anvil fork of the target chain)
#   Live deployment:  your own private endpoint     (Alchemy, Infura, QuickNode, own node)
# Leave empty for a dry-run: the pipeline then uses the read-only public endpoint
# listed in contexts/<chain>.json. A --broadcast always requires RPC_URL.
RPC_URL=

# ───────────────────────────── Deployer private key ─────────────────────────
# REQUIRED ONLY to create a vault (--broadcast). Without it every simulation
# still works: validation, address preview, the full dry-run plan.
# Format: 0x + 64 hex characters.
#
# For a fork rehearsal against anvil you can use anvil's default account #0,
# whose key is public and must never hold real funds:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# For a live deployment this is the key that signs the clone and every
# configuration transaction and that holds every role during the trial.
# Fund it with gas on the target chain before broadcasting.
DEPLOYER_PRIVATE_KEY=
